# Định hướng cấu hình; chưa có ứng dụng đọc các biến này.
# Sao chép sang .env khi triển khai; không commit credential thật.
# App và lab cần kết nối, credential/quyền và cấu hình riêng.
APP_MYSQL_HOST=<app-host>
APP_MYSQL_PORT=<app-port>
APP_MYSQL_DATABASE=partstock
APP_MYSQL_USER=<app-user>
APP_MYSQL_PASSWORD=<app-password>
LAB_MYSQL_HOST=<lab-host>
LAB_MYSQL_PORT=<lab-port>
LAB_MYSQL_DATABASE=partstock_lab
LAB_MYSQL_USER=<lab-user>
LAB_MYSQL_PASSWORD=<lab-password>
LAB_MONGODB_URI=<lab-uri-with-dedicated-credentials>
LAB_MONGODB_DATABASE=partstock_lab
